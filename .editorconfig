# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# biome formats these, and it formats with tabs. Stated here so an editor's
# editorconfig support does not fight `pnpm format`.
[*.{js,jsx,ts,tsx,json,jsonc}]
indent_style = tab
